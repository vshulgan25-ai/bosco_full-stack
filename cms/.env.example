# Налаштування хмарної бази даних Neon PostgreSQL
# Формат підключення: postgresql://[user]:[password]@[neon-hostname]/[database]?sslmode=require
DATABASE_URI=postgresql://neondb_owner:npg_secret@ep-cool-lake-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Секретний ключ для шифрування сесій та токенів Payload CMS
PAYLOAD_SECRET=bosco-super-secret-key-2026-production-ready

# Порт та URL бекенду
PORT=3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Дозволені джерела CORS (через кому або масив на фронтенд)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://bosco-scholarships-frontend.vercel.app

# Пароль для початкової ініціалізації учнів у seed-скрипті
SEED_STUDENT_PASSWORD=Bosco2026!

# Адреса основного сайту, куди веде лендінг (кнопки «Перейти на основний сайт»)
MAIN_SITE_URL=https://mnzbosco.org.ua/

# Адреса сайту (лендінгу): відвідувачі, які відкрили адресу CMS, автоматично потраплять сюди
FRONTEND_URL=http://localhost:5173
